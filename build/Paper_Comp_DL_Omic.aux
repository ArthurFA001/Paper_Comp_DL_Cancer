\citation{gorodkin2004comparing}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Comparativa de rendimiento entre arquitecturas de aprendizaje profundo para la clasificación multiclase de tipos de cáncer utilizando datos multiómicos integrados. Se presentan las métricas clave: Coeficiente de Correlación de Matthews (MCC), Exactitud, Precisión, Sensibilidad (Recall), F1-Score y Tiempo de entrenamiento. Los resultados destacan la superioridad de las arquitecturas basadas en grafos (GNN) en comparación con los enfoques espaciales (CNN) y secuenciales (RNN).}}{23}{table.1}\protected@file@percent }
\newlabel{tab:global_performance}{{1}{23}{Comparativa de rendimiento entre arquitecturas de aprendizaje profundo para la clasificación multiclase de tipos de cáncer utilizando datos multiómicos integrados. Se presentan las métricas clave: Coeficiente de Correlación de Matthews (MCC), Exactitud, Precisión, Sensibilidad (Recall), F1-Score y Tiempo de entrenamiento. Los resultados destacan la superioridad de las arquitecturas basadas en grafos (GNN) en comparación con los enfoques espaciales (CNN) y secuenciales (RNN)}{table.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Resultados}{23}{section.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Comparativa global de rendimiento}{23}{subsection.3.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Analisis de estabilidad}{24}{subsection.3.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Análisis de estabilidad de las arquitecturas de aprendizaje profundo mediante el Coeficiente de Correlación de Matthews (MCC). Se presentan la media ($\mu $), desviación estándar ($\sigma $) y el rango de valores (Min - Max) obtenidos en cinco corridas independientes. La interpretación cualitativa de la estabilidad se basa en la consistencia de los resultados, destacando la robustez de las arquitecturas basadas en grafos (GNN) en comparación con los enfoques espaciales (CNN) y secuenciales (RNN).}}{25}{table.2}\protected@file@percent }
\newlabel{tab:estabilidad}{{2}{25}{Análisis de estabilidad de las arquitecturas de aprendizaje profundo mediante el Coeficiente de Correlación de Matthews (MCC). Se presentan la media ($\mu $), desviación estándar ($\sigma $) y el rango de valores (Min - Max) obtenidos en cinco corridas independientes. La interpretación cualitativa de la estabilidad se basa en la consistencia de los resultados, destacando la robustez de las arquitecturas basadas en grafos (GNN) en comparación con los enfoques espaciales (CNN) y secuenciales (RNN)}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Análisis de estabilidad de las arquitecturas de aprendizaje profundo mediante Exactitud y Precisión. Se presentan los valores promedio y desviación estándar obtenidos en cinco corridas independientes para cada modelo. Los resultados destacan la consistencia de las arquitecturas basadas en grafos (GNN) en comparación con los enfoques espaciales (CNN) y secuenciales (RNN).}}{26}{table.3}\protected@file@percent }
\newlabel{tab:estabilidad_acc_prec}{{3}{26}{Análisis de estabilidad de las arquitecturas de aprendizaje profundo mediante Exactitud y Precisión. Se presentan los valores promedio y desviación estándar obtenidos en cinco corridas independientes para cada modelo. Los resultados destacan la consistencia de las arquitecturas basadas en grafos (GNN) en comparación con los enfoques espaciales (CNN) y secuenciales (RNN)}{table.3}{}}
